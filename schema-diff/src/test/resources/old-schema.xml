<?xml version="1.0" encoding="UTF-8"?>
<schema>
  <table name="users">
    <column name="id" type="int" required="true"/>
    <column name="name" type="varchar" length="100" required="true"/>
    <column name="email" type="varchar" length="100" required="false"/>
    <key type="primary">
      <column name="id"/>
    </key>
  </table>
  <table name="posts">
    <column name="id" type="int" required="true"/>
    <column name="user_id" type="int" required="true"/>
    <column name="title" type="varchar" length="255" required="true"/>
    <column name="content" type="text" required="false"/>
    <key type="primary">
      <column name="id"/>
    </key>
    <relation from-column="user_id" to-table="users" to-column="id" type="cascade"/>
  </table>
</schema>
